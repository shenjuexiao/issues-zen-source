---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { ClientRouter, slide } from 'astro:transitions'
import { GoogleAnalytics } from 'astro-google-analytics'
import { siteConfig } from '../config'
import DemoBanner from '../components/DemoBanner.astro'

interface Props {
  title: string
  description?: string
}

const { title, description = 'A minimal blog focused on excellent reading experience' } = Astro.props

const canonicalURL = new URL(Astro.url.pathname, siteConfig.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {siteConfig.googleAnalysis && <GoogleAnalytics id={siteConfig.googleAnalysis} />}
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-white dark:bg-gray-900">
    <DemoBanner />
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <Header transition:persist />
      <main class="py-12" transition:animate={slide({ duration: '.3s' })}>
        <slot />
      </main>
      <Footer transition:persist />
    </div>
  </body>
</html>
